# Production deployments must use APP_ENV=production (the production compose
# service also sets it explicitly). Development remains the local default.
APP_ENV=development

POSTGRES_DB=corpus
POSTGRES_USER=corpus
POSTGRES_PASSWORD=replace_with_a_strong_db_password
POSTGRES_HOST=mobile-money-corpus-db

JWT_SECRET=replace_with_at_least_32_random_characters
WORKSHOP_CODE_SECRET=replace_with_a_distinct_32_character_random_secret
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=true
MAX_AUDIO_MB=50
FFMPEG_TIMEOUT_SECONDS=60
FFPROBE_TIMEOUT_SECONDS=10
MIN_AUDIO_DURATION_SECONDS=0.25
MAX_AUDIO_DURATION_SECONDS=120
MAX_CONCURRENT_CONVERSIONS=2

MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password
MINIO_ENDPOINT=mobile-money-corpus-minio:9000
MINIO_ACCESS_KEY=replace_with_minio_user
MINIO_SECRET_KEY=replace_with_a_strong_minio_password
MINIO_SECURE=false
MINIO_BUCKET=mobile-money-corpus

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Exposition Traefik
APP_HOST=mobile-money-corpus.example.com
FORWARDED_ALLOW_IPS=172.22.0.0/16
BACKUP_DIR=/var/backups/mobile-money-corpus
TRAEFIK_CERT_RESOLVER=replace_with_cert_resolver
